{
  "name": "vervet",
  "version": "2026.04.6",
  "description": "A desktop Mongo DB tool",
  "productName": "Vervet",
  "author": "Sean Garrett <sean@blacktau.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "bunx --bun eslint -c ./eslint.config.ts \"./src*/**/*.{ts,js,cjs,mjs,vue}\" && bunx --bun vue-tsc --noEmit --strict",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "dev": "bunx --bun vite",
    "build": "bunx --bun vue-tsc --noEmit && bunx --bun vite build",
    "preview": "bunx --bun vite preview"
  },
  "dependencies": {
    "@babel/parser": "^7.29.8",
    "@heroicons/vue": "^2.2.0",
    "color": "^5.0.3",
    "copy-text-to-clipboard": "^3.2.2",
    "dayjs": "^1.11.21",
    "lodash": "^4.18.1",
    "monaco-editor": "^0.55.1",
    "pinia": "^3.0.4",
    "sass": "^1.102.0",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.41",
    "vue-i18n": "^11.4.8",
    "wcwidth": "^1.0.1"
  },
  "devDependencies": {
    "@babel/types": "^7.29.8",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.3",
    "@types/sortablejs": "^1.15.9",
    "@vicons/tabler": "^0.13.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.4.11",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "~10.5.1",
    "happy-dom": "^20.11.2",
    "jiti": "^2.7.0",
    "naive-ui": "^2.44.1",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^20.3.0",
    "unplugin-icons": "^22.5.0",
    "unplugin-vue-components": "^30.0.0",
    "vite": "^7.3.6",
    "vite-plugin-monaco-editor": "^1.1.0",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.10"
  },
  "overrides": {
    "dompurify": "^3.4.13",
    "vue-template-compiler": "npm:@vue/compiler-sfc@^3.5.30",
    "rollup": "^4.59.0",
    "flatted": "^3.4.0",
    "picomatch": "^2.3.2",
    "postcss": "^8.5.26",
    "minimatch": "^9.0.6",
    "brace-expansion": "^2.1.3",
    "immutable": "^5.1.9",
    "lodash": "^4.18.1",
    "lodash-es": "^4.18.1"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
